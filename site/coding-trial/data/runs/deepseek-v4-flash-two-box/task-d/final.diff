+def _fmt(value) -> str:
+    return f"{value:.2f}"
+
+
+def render_json(ledger: Ledger) -> str:
+    categories = {
+        category: {
+            "net": _fmt(net),
+        }
+        for category, net in ledger.category_totals().items()
+    }
+    payload = {
+        "purchases": _fmt(ledger.gross_purchases()),
+        "refunds": _fmt(ledger.total_refunds()),
+        "net": _fmt(ledger.net_total()),
+        "categories": categories,
+    }
+    return json.dumps(payload, indent=2)
+
