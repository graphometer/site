+++ b/tests/test_cli.py
@@ -0,0 +1,77 @@
+import io
+import json
+import sys
+import unittest
+from contextlib import redirect_stdout
+from decimal import Decimal
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).parents[1] / "src"))
+
+from ledgerlite.cli import main
+
+CSV = (
+    "Keyboard,equipment,purchase,120.00\n"
+    "Keyboard return,equipment,refund,20.00\n"
+    "Book,learning,purchase,30.00\n"
+)
+
+
+def _write_csv(tmp: Path) -> Path:
+    path = tmp / "transactions.csv"
+    path.write_text(CSV, encoding="utf-8")
+    return path
+
+
+class CliJsonTests(unittest.TestCase):
+    def test_json_output_shape_and_strings(self) -> None:
+        import tempfile
+
+        with tempfile.TemporaryDirectory() as tmp:
+            path = _write_csv(Path(tmp))
+            stdout = io.StringIO()
+            with redirect_stdout(stdout):
+                self.assertEqual(main([str(path), "--json"]), 0)
+            payload = json.loads(stdout.getvalue())
+        self.assertEqual(payload["purchases"], "150.00")
+        self.assertEqual(payload["refunds"], "20.00")
+        self.assertEqual(payload["net"], "130.00")
+        self.assertEqual(
+            payload["categories"],
+            {"equipment": {"net": "100.00"}, "learning": {"net": "30.00"}},
+        )
+        for value in payload.values():
+            self.assertTrue(isinstance(value, (str, dict)))
+
+    def test_json_categories_sorted(self) -> None:
+        import tempfile
+
+        csv_path = Path(tempfile.mkdtemp()) / "t.csv"
+        csv_path.write_text(
+            "Zed,zeta,purchase,5.00\nAlpha,alpha,purchase,7.00\n",
+            encoding="utf-8",
+        )
+        stdout = io.StringIO()
+        with redirect_stdout(stdout):
+            main([str(csv_path), "--json"])
+        payload = json.loads(stdout.getvalue())
+        self.assertEqual(list(payload["categories"].keys()), ["alpha", "zeta"])
+
+
+class CliTextTests(unittest.TestCase):
+    def test_text_output_unchanged(self) -> None:
+        import tempfile
+
+        with tempfile.TemporaryDirectory() as tmp:
+            path = _write_csv(Path(tmp))
+            stdout = io.StringIO()
+            with redirect_stdout(stdout):
+                self.assertEqual(main([str(path)]), 0)
+            self.assertEqual(
+                stdout.getvalue(),
+                "Purchases: $150.00\nRefunds: $20.00\nNet: $130.00\n",
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
