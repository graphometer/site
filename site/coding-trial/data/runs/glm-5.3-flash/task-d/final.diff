diff --git a/src/ledgerlite/ledger.py b/src/ledgerlite/ledger.py
index ac3cf09..c644861 100644
--- a/src/ledgerlite/ledger.py
+++ b/src/ledgerlite/ledger.py
@@ -21,5 +21,14 @@ class Ledger:
         )
 
     def net_total(self) -> Decimal:
-        # Intentional benchmark bug: refunds are represented as positive amounts.
-        return sum((item.amount for item in self.transactions), start=Decimal("0"))
+        return self.gross_purchases() - self.total_refunds()
+
+    def category_totals(self) -> dict[str, Decimal]:
+        totals: dict[str, Decimal] = {}
+        for item in self.transactions:
+            current = totals.get(item.category, Decimal("0"))
+            if item.kind == "purchase":
+                totals[item.category] = current + item.amount
+            else:
+                totals[item.category] = current - item.amount
+        return dict(sorted(totals.items()))
