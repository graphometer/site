diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..7d4568e
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,65 @@
+import contextlib
+import io
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).parents[1] / "src"))
+
+from ledgerlite.cli import main
+
+
+CSV_ROWS = "Keyboard,equipment,purchase,120.00\nBook,learning,purchase,30.00\nKeyboard return,equipment,refund,20.00\n"
+
+
+class CliTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.tmp = tempfile.TemporaryDirectory()
+        self.csv_path = Path(self.tmp.name) / "transactions.csv"
+        self.csv_path.write_text(CSV_ROWS, encoding="utf-8")
+
+    def tearDown(self) -> None:
+        self.tmp.cleanup()
+
+    def run_cli(self, *argv: str) -> str:
+        buffer = io.StringIO()
+        with contextlib.redirect_stdout(buffer):
+            code = main([str(self.csv_path), *argv])
+        self.assertEqual(code, 0)
+        return buffer.getvalue()
+
+    def test_text_output_unchanged(self) -> None:
+        self.assertEqual(
+            self.run_cli(),
+            "Purchases: $150.00\nRefunds: $20.00\nNet: $130.00\n",
+        )
+
+    def test_json_output_contains_string_amounts_and_categories(self) -> None:
+        payload = json.loads(self.run_cli("--json"))
+        self.assertEqual(payload["purchases"], "150.00")
+        self.assertEqual(payload["refunds"], "20.00")
+        self.assertEqual(payload["net"], "130.00")
+        self.assertEqual(
+            payload["categories"],
+            {"equipment": "100.00", "learning": "30.00"},
+        )
+
+    def test_json_categories_ordered_by_category(self) -> None:
+        path = Path(self.tmp.name) / "unordered.csv"
+        path.write_text(
+            "Zeta item,zeta,purchase,1.00\nAlpha item,alpha,purchase,2.00\n",
+            encoding="utf-8",
+        )
+        buffer = io.StringIO()
+        with contextlib.redirect_stdout(buffer):
+            code = main(["--json", str(path)])
+        self.assertEqual(code, 0)
+        raw = buffer.getvalue()
+        self.assertLess(raw.index('"alpha"'), raw.index('"zeta"'))
+        self.assertEqual(list(json.loads(raw)["categories"]), ["alpha", "zeta"])
+
+
+if __name__ == "__main__":
+    unittest.main()
