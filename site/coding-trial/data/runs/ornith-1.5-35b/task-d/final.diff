diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..b768e64
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,57 @@
+import contextlib
+import io
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).parents[1] / "src"))
+
+from ledgerlite.cli import main
+
+
+class CLITests(unittest.TestCase):
+    def _write_csv(self, text: str) -> Path:
+        handle = tempfile.NamedTemporaryFile(
+            "w", suffix=".csv", delete=False, encoding="utf-8", newline=""
+        )
+        try:
+            handle.write(text)
+        finally:
+            handle.close()
+        self.addCleanup(Path(handle.name).unlink)
+        return Path(handle.name)
+
+    def test_default_output_is_unchanged_text(self) -> None:
+        path = self._write_csv("Book,learning,purchase,12.50\n")
+        buffer = io.StringIO()
+        with contextlib.redirect_stdout(buffer):
+            rc = main([str(path)])
+        self.assertEqual(rc, 0)
+        self.assertEqual(
+            buffer.getvalue(), "Purchases: $12.50\nRefunds: $0.00\nNet: $12.50\n"
+        )
+
+    def test_json_flag_emits_json(self) -> None:
+        path = self._write_csv(
+            "Keyboard,equipment,purchase,120.00\n"
+            "Keyboard return,equipment,refund,20.00\n"
+            "Book,learning,purchase,30.00\n"
+        )
+        buffer = io.StringIO()
+        with contextlib.redirect_stdout(buffer):
+            rc = main([str(path), "--json"])
+        self.assertEqual(rc, 0)
+
+        payload = json.loads(buffer.getvalue())
+        self.assertEqual(payload["purchases"], "150.00")
+        self.assertEqual(payload["refunds"], "20.00")
+        self.assertEqual(payload["net"], "130.00")
+        self.assertEqual(payload["categories"], {"equipment": "100.00", "learning": "30.00"})
+        for key in ("purchases", "refunds", "net"):
+            self.assertIsInstance(payload[key], str)
+
+
+if __name__ == "__main__":
+    unittest.main()
