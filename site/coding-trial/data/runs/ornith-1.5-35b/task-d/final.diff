 from .ledger import Ledger
 
 
@@ -9,3 +11,18 @@ def render_text(ledger: Ledger) -> str:
             f"Net: ${ledger.net_total():.2f}",
         ]
     )
+
+
+def render_json(ledger: Ledger) -> str:
+    return json.dumps(
+        {
+            "purchases": str(ledger.gross_purchases()),
+            "refunds": str(ledger.total_refunds()),
+            "net": str(ledger.net_total()),
+            "categories": {
+                category: str(total)
+                for category, total in ledger.category_totals().items()
+            },
+        },
+        indent=2,
+    )
