diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..050eadb
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,56 @@
+import csv
+import io
+import json
+import sys
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+from decimal import Decimal
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).parents[1] / "src"))
+
+from ledgerlite.cli import main
+
+CSV_CONTENT = (
+    "Keyboard,equipment,purchase,120.00\n"
+    "Book,learning,purchase,30.00\n"
+    "Keyboard return,equipment,refund,20.00\n"
+)
+
+
+class CliTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self._tmp = tempfile.NamedTemporaryFile(
+            mode="w", suffix=".csv", delete=False, encoding="utf-8"
+        )
+        self._tmp.write(CSV_CONTENT)
+        self._tmp.close()
+        self.path = self._tmp.name
+
+    def tearDown(self) -> None:
+        Path(self.path).unlink()
+
+    def _run(self, argv: list[str]) -> tuple[int, str]:
+        buffer = io.StringIO()
+        with redirect_stdout(buffer):
+            rc = main(argv)
+        return rc, buffer.getvalue()
+
+    def test_default_output_is_text(self) -> None:
+        rc, out = self._run([self.path])
+        self.assertEqual(rc, 0)
+        self.assertEqual(out, "Purchases: $150.00\nRefunds: $20.00\nNet: $130.00\n")
+
+    def test_json_flag_emits_json(self) -> None:
+        rc, out = self._run(["--json", self.path])
+        self.assertEqual(rc, 0)
+        data = json.loads(out)
+        self.assertEqual(data["purchases"], "150.00")
+        self.assertEqual(data["refunds"], "20.00")
+        self.assertEqual(data["net"], "130.00")
+        self.assertEqual(data["categories"], {"equipment": "100.00", "learning": "30.00"})
+
+
+if __name__ == "__main__":
+    unittest.main()
