@@ -25,6 +25,58 @@ class LedgerTests(unittest.TestCase):
     def test_net_total_subtracts_refunds(self) -> None:
         self.assertEqual(self.ledger.net_total(), Decimal("130.00"))
 
+    def test_net_matches_purchases_minus_refunds(self) -> None:
+        self.assertEqual(
+            self.ledger.net_total(),
+            self.ledger.gross_purchases() - self.ledger.total_refunds(),
+        )
+
+
+class CategoryTotalsTests(unittest.TestCase):
+    def test_refunds_reduce_category_net(self) -> None:
+        ledger = Ledger(
+            [
+                Transaction("Desk", "equipment", "purchase", Decimal("200.00")),
+                Transaction("Desk return", "equipment", "refund", Decimal("50.00")),
+            ]
+        )
+        self.assertEqual(ledger.category_totals(), {"equipment": Decimal("150.00")})
+
+    def test_categories_are_sorted_deterministically(self) -> None:
+        ledger = Ledger(
+            [
+                Transaction("A", "travel", "purchase", Decimal("5.00")),
+                Transaction("B", "supplies", "purchase", Decimal("3.00")),
+                Transaction("C", "travel", "purchase", Decimal("2.00")),
+                Transaction("D", "meals", "purchase", Decimal("4.00")),
+            ]
+        )
+        self.assertEqual(
+            list(ledger.category_totals().keys()),
+            ["meals", "supplies", "travel"],
+        )
+        self.assertEqual(
+            ledger.category_totals(),
+            {
+                "meals": Decimal("4.00"),
+                "supplies": Decimal("3.00"),
+                "travel": Decimal("7.00"),
+            },
+        )
+
+    def test_category_nets_sum_to_net_total(self) -> None:
+        ledger = Ledger(
+            [
+                Transaction("Keyboard", "equipment", "purchase", Decimal("120.00")),
+                Transaction("Book", "learning", "purchase", Decimal("30.00")),
+                Transaction("Keyboard return", "equipment", "refund", Decimal("20.00")),
+            ]
+        )
+        self.assertEqual(
+            sum(ledger.category_totals().values(), start=Decimal("0")),
+            ledger.net_total(),
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
