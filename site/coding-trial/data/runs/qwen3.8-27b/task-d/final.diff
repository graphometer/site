diff --git a/src/ledgerlite/ledger.py b/src/ledgerlite/ledger.py
index ac3cf09..2583ac9 100644
--- a/src/ledgerlite/ledger.py
+++ b/src/ledgerlite/ledger.py
@@ -21,5 +21,12 @@ class Ledger:
         )
 
     def net_total(self) -> Decimal:
-        # Intentional benchmark bug: refunds are represented as positive amounts.
-        return sum((item.amount for item in self.transactions), start=Decimal("0"))
+        # Refunds are stored as positive amounts; kind carries the sign.
+        return self.gross_purchases() - self.total_refunds()
+
+    def category_totals(self) -> dict[str, Decimal]:
+        totals: dict[str, Decimal] = {}
+        for item in self.transactions:
+            delta = item.amount if item.kind == "purchase" else -item.amount
+            totals[item.category] = totals.get(item.category, Decimal("0")) + delta
+        return dict(sorted(totals.items()))
diff --git a/src/ledgerlite/report.py b/src/ledgerlite/report.py
index 0673a45..d55cc62 100644
--- a/src/ledgerlite/report.py
+++ b/src/ledgerlite/report.py
@@ -1,3 +1,5 @@
+import json
+
 from .ledger import Ledger
 
 
@@ -9,3 +11,17 @@ def render_text(ledger: Ledger) -> str:
             f"Net: ${ledger.net_total():.2f}",
         ]
     )
+
+
+def render_json(ledger: Ledger) -> str:
+    return json.dumps(
+        {
+            "purchases": f"{ledger.gross_purchases():.2f}",
+            "refunds": f"{ledger.total_refunds():.2f}",
+            "net": f"{ledger.net_total():.2f}",
+            "categories": {
+                category: f"{amount:.2f}" for category, amount in ledger.category_totals().items()
+            },
+        },
+        indent=2,
+    )
diff --git a/tests/test_ledger.py b/tests/test_ledger.py
index 24b66ae..c86d847 100644
--- a/tests/test_ledger.py
+++ b/tests/test_ledger.py
@@ -25,6 +25,34 @@ class LedgerTests(unittest.TestCase):
     def test_net_total_subtracts_refunds(self) -> None:
         self.assertEqual(self.ledger.net_total(), Decimal("130.00"))
 
+    def test_category_totals_subtract_category_refunds(self) -> None:
+        self.assertEqual(
+            self.ledger.category_totals(),
+            {"equipment": Decimal("100.00"), "learning": Decimal("30.00")},
+        )
+
+    def test_category_totals_can_go_negative(self) -> None:
+        ledger = Ledger(
+            [
+                Transaction("Gadget", "misc", "purchase", Decimal("30.00")),
+                Transaction("Gadget return", "misc", "refund", Decimal("50.00")),
+            ]
+        )
+        self.assertEqual(ledger.category_totals(), {"misc": Decimal("-20.00")})
+
+    def test_category_totals_sorted_by_category(self) -> None:
+        ledger = Ledger(
+            [
+                Transaction("Z", "zebra", "purchase", Decimal("1.00")),
+                Transaction("A", "alpha", "purchase", Decimal("2.00")),
+                Transaction("M", "mid", "purchase", Decimal("3.00")),
+            ]
+        )
+        self.assertEqual(
+            list(ledger.category_totals()),
+            ["alpha", "mid", "zebra"],
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
